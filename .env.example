# Server
PORT=4101
NODE_ENV=development

# Public URL where this dashboard is reachable (production only; leave blank in dev)
PUBLIC_BASE_URL=

# TMS API
TMS_BASE_URL=https://tmsapis.cjdarcl.com
TMS_AUTH_TOKEN=

# Demo mode: when "true" the dashboard serves mock data instead of calling TMS
DEMO_MODE=true

# SMTP (only required to actually send certificate emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CJ Darcl Sustainability <noreply@cjdarcl.com>"
