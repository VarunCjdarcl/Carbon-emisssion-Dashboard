# Dependencies
node_modules/

# Local databases (runtime data, not source)
backend/data/*.sqlite
backend/data/*.sqlite-shm
backend/data/*.sqlite-wal

# Environment files (contain secrets — never commit)
.env
.env.local
.env.*.local

# SSL certificates (uploaded to the deploy server out-of-band)
backend/ssl/

# Claude Code local settings
.claude/settings.local.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Build / cache
dist/
build/
.cache/
